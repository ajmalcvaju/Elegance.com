<!DOCTYPE html>
<html lang="en">

<head>
    <title>New Password</title>

    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;500;600&display=swap" rel="stylesheet">
    <!--Stylesheet-->
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #0d0d0d;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            padding: 20px;
        }

        .form-container {
            background: linear-gradient(135deg, rgba(30,30,30,0.9), rgba(50,50,50,0.9));
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0px 0px 20px rgba(0, 255, 255, 0.3);
            width: 100%;
            max-width: 400px;
            text-align: center;
            border: 2px solid rgba(0, 255, 255, 0.5);
        }

        h3 {
            color: #00ffff;
            font-size: 28px;
            margin-bottom: 20px;
            text-shadow: 0px 0px 10px rgba(0, 255, 255, 0.8);
        }

        input {
            width: 100%;
            padding: 12px;
            margin-top: 15px;
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(0, 255, 255, 0.4);
            border-radius: 6px;
            font-size: 16px;
            color: #fff;
            transition: all 0.3s ease-in-out;
        }

        input:focus {
            border-color: #00ffff;
            outline: none;
            box-shadow: 0px 0px 10px rgba(0, 255, 255, 0.8);
        }

        ::placeholder {
            color: rgba(255, 255, 255, 0.5);
        }

        button {
            width: 100%;
            padding: 14px;
            margin-top: 20px;
            background: #00ffff;
            color: #0d0d0d;
            font-size: 18px;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            transition: all 0.3s ease-in-out;
            border: none;
        }

        button:hover {
            background: #008080;
            color: #fff;
            box-shadow: 0px 0px 10px rgba(0, 255, 255, 0.7);
        }

        .error-message {
            color: red;
            margin-top: 5px;
            font-size: 14px;
        }

        @media screen and (max-width: 500px) {
            .form-container {
                padding: 30px;
            }

            h3 {
                font-size: 24px;
            }

            input {
                font-size: 14px;
            }

            button {
                font-size: 16px;
            }
        }
    </style>

</head>

     <div class="form-container">
        <h3>Change Your Password</h3>
        <form id="passwordForm" action="/myProfile/changePassword" method="post" onsubmit="return validateForm()">
            <input type="password" name="password" placeholder="Enter New Password" id="password" onblur="validatePassword(this.value)">
            <div id="passwordErrors" class="error-message"></div>

            <input type="password" name="confirmPassword" placeholder="Confirm New Password" id="confirmPassword">
            <div id="confirmPasswordError" class="error-message"></div>

            {{#if passwordError}}
            <p class="error-message">Your Confirmation Password is Incorrect! Try Again.</p>
            {{/if}}

            <button type="submit" id="otpVerification">Continue</button>
        </form>
    </div>

    <script>
        function validatePassword(password) {
            var passwordInput = document.getElementById("password");
            var passwordErrors = document.getElementById("passwordErrors");

            // Reset error messages
            passwordErrors.innerHTML = "";

            // Check length
            if (password.length < 8) {
                passwordErrors.innerHTML += "Password must have at least 8 characters.<br>";
            }

            // Check for at least one digit
            if (!/\d/.test(password)) {
                passwordErrors.innerHTML += "Password must contain at least one digit.<br>";
            }

            // Check for at least one uppercase letter
            if (!/[A-Z]/.test(password)) {
                passwordErrors.innerHTML += "Password must contain at least one uppercase letter.<br>";
            }

            // Check for at least one symbol
            if (!/[^a-zA-Z0-9]/.test(password)) {
                passwordErrors.innerHTML += "Password must contain at least one symbol.<br>";
            }

            // If there are errors, display them and set border color to red
            if (passwordErrors.innerHTML !== "") {
                passwordInput.style.border = "1px solid red";
            } else {
                // If no errors, reset border color
                passwordInput.style.border = "1px solid #ccc";
            }
        }

        function validateForm() {
            var password = document.getElementById("password").value;
            var confirmPassword = document.getElementById("confirmPassword").value;
            var passwordErrors = document.getElementById("passwordErrors");
            var confirmPasswordError = document.getElementById("confirmPasswordError");

            // Reset previous error messages
            confirmPasswordError.textContent = "";

            // Check if password field is empty
            if (!password) {
                confirmPasswordError.textContent = "Password is required.";
                return false;
            }

            // Perform password validation
            validatePassword(password);

            // If password validation has errors, prevent form submission
            if (passwordErrors.innerHTML !== "") {
                return false;
            }

            // Check if confirm password field is empty
            if (!confirmPassword) {
                confirmPasswordError.textContent = "Confirm Password is required.";
                return false;
            }

            // Check if passwords match
            if (password !== confirmPassword) {
                confirmPasswordError.textContent = "Passwords do not match.";
                return false;
            }

            return true;
        }
    </script>
</body>

</html>