    <style>
        #add-to-cart-link:hover {
            cursor: pointer;
        }

        /* Dark Theme */
        body {
            background-color: #121212;
            color: white;
            font-family: 'Arial', sans-serif;
        }

        /* Section Styling */
        .product-section {
            padding: 60px 0;
        }

        .sec-tl h1 {
            font-size: 2.5rem;
            font-weight: bold;
            color: #FFD700;
            text-transform: uppercase;
            letter-spacing: 2px;
            position: relative;
            display: inline-block;
        }

        .sec-tl h1::after {
            content: '';
            width: 60px;
            height: 4px;
            background: #FFD700;
            display: block;
            margin: 10px auto;
        }

        /* Product Card */
        .block-product {
            background: #1E1E1E;
            border-radius: 12px;
            padding: 15px;
            margin-bottom: 30px;
            transition: transform 0.3s ease-in-out;
        }

        .block-product:hover {
            transform: translateY(-10px);
            box-shadow: 0 0 10px #FFD700;
        }

        /* Product Image */
        .product-thumb {
            position: relative;
            text-align: center;
        }

        .product-thumb img {
            width: 100%;
            border-radius: 10px;
            transition: transform 0.3s ease-in-out;
        }

        .product-thumb img:hover {
            transform: scale(1.05);
        }

        /* Discount Badge */
        .discount-badge {
            position: absolute;
            top: 10px;
            left: 10px;
            background: #FF5733;
            color: white;
            padding: 5px 10px;
            border-radius: 5px;
            font-weight: bold;
        }

        /* Add to Cart Button */
        .ad-cart {
            position: absolute;
            bottom: 15px;
            right: 15px;
            background: #FFD700;
            color: black;
            padding: 10px 15px;
            font-weight: bold;
            border-radius: 5px;
            cursor: pointer;
            transition: background 0.3s ease-in-out;
        }

        .ad-cart:hover {
            background: #FFC300;
        }

        /* Product Details */
        .product-body {
            margin-top: 15px;
        }

        .brand-name {
            font-size: 1.2rem;
            font-weight: bold;
            color: #FFD700;
        }

        .product-price {
            font-size: 1.5rem;
            color: #28A745;
        }

        .product-price del {
            color: red;
        }

        .navbar-dark .nav-link {
            color: white;
            font-size: 1.1rem;
            font-weight: 600;
        }

        .navbar-dark .nav-link:hover {
            color: #a855f7;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .block-product {
                margin: 0 auto 20px auto;
            }
        }
    </style>

