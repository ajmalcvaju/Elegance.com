<!doctype html>
<html lang="en">

<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css"
        integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">

    <title>User Order status</title>
<style>
        body {
            background-color: #121212;
            color: white;
            font-family: Arial, sans-serif;
        }
        .content {
            display: flex;
            flex-direction: column;
            padding: 20px;
        }
        #aPanel {
            width: 100%;
            display: flex;
            height: 5%;
            justify-content: center;
            align-items: center;
            background-color: #1f1f1f;
            padding: 10px;
            border-radius: 10px;
        }
        #aPanel2 {
            width: 100%;
            height: auto;
            display: flex;
            flex-direction: column;
            padding: 20px;
            background-color: #1c1c1c;
            border-radius: 10px;
        }
        .breadcrumb-item a {
            color: #ff9800;
            text-decoration: none;
        }
        .breadcrumb-item.active {
            color: #ff5722;
        }
        table {
            margin-top: 20px;
            background-color: #212121;
            border-radius: 10px;
            overflow: hidden;
        }
        th, td {
            color: white;
            text-align: center;
            vertical-align: middle;
        }
        .btn-info {
            background-color: #17a2b8;
            border: none;
        }
        .btn-danger {
            background-color: #e63946;
            border: none;
        }
        .btn-warning {
            background-color: #f4a261;
            border: none;
        }
        .btn-success {
            background-color: #2a9d8f;
            border: none;
        }
        .btn:hover {
            opacity: 0.8;
        }
        @media (max-width: 768px) {
            table {
                font-size: 12px;
            }
            .btn {
                padding: 5px;
                font-size: 12px;
            }
        }
    </style>
</head>

<body>
    <header>
        <div class="content">
            <div id="aPanel">
                <h3>Order Status</h3>
            </div>
            <div id="aPanel2">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Order Details</li>
                    </ol>
                </nav>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Order Id</th>
                            <th>Order Date</th>
                            <th>Product Quantity</th>
                            <th>Total Price</th>
                            <th>Status</th>
                            <th>Payment Status</th>
                            <th>Payment Method</th>
                            <th>Product Detail</th>
                            <th>Cancel/Return</th>
                            <th>Reason</th>
                            <th>Repay</th>
                            <th>Invoice</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each order}}
                        <tr>
                            <td>{{this.orderId}}</td>
                            <td>{{this.date}}</td>
                            <td>{{this.productQuantity}}</td>
                            <td>{{#if this.priceAfterCoupon}}{{this.priceAfterCoupon}}{{else}}{{this.totalAmountPay}}{{/if}}</td>
                            <td>{{this.status}}</td>
                            <td>{{this.paymentStatus}}</td>
                            <td>{{this.paymentMethod}}</td>
                            <td><a href="/orderDetails?orderId={{this.orderId}}" class="btn btn-info">Details</a></td>
                            <td>
                                {{#if (eq this.status "Delivered")}}
                                <a href="#" class="btn btn-danger" onclick="confirmReturn('{{this._id}}', '{{this.orderId}}')">Return</a>
                                {{else}}
                                <a href="#" class="btn btn-danger" onclick="confirmCancel('{{this._id}}', '{{this.orderId}}')">Cancel</a>
                                {{/if}}
                            </td>
                            <td>{{#if this.reasonForCancelation}}{{this.reasonForCancelation}}{{else if this.reasonForReturn}}{{this.reasonForReturn}}{{else}}N/A{{/if}}</td>
                            <td>
                                {{#if (eq this.paymentStatus "Failed")}}
                                <form action="/repay" method="post">
                                    <input type="hidden" name="totalAmountPay" value="{{#if this.priceAfterCoupon}}{{this.priceAfterCoupon}}{{else}}{{this.totalAmountPay}}{{/if}}">
                                    <input type="hidden" name="orderId" value="{{this.orderId}}">
                                    <button type="submit" class="btn btn-success">Repay</button>
                                </form>
                                {{else}}N/A{{/if}}
                            </td>
                            <td>
                                {{#if (eq this.status "Delivered")}}
                                <a href="/invoice?orderId={{this.orderId}}" class="btn btn-warning">Invoice</a>
                                {{else}}N/A{{/if}}
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </header>        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <!-- Optional JavaScript -->
        <!-- jQuery first, then Popper.js, then Bootstrap JS -->
        <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js"
            integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n"
            crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js"
            integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo"
            crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js"
            integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6"
            crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
    function confirmCancel(orderId, displayOrderId) {
        Swal.fire({
            title: 'Are you sure?',
            text: `Do you want to cancel order ${displayOrderId}?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, cancel it!',
            input: 'textarea',  // Add a textarea input for the reason
            inputPlaceholder: 'Enter the reason for cancellation...',
            inputValidator: (value) => {
                if (!value) {
                    return 'You need to provide a reason for cancellation!';
                }
            }
        }).then((result) => {
            if (result.isConfirmed) {
                const reason = result.value; // Get the reason from the input

                // Display a message for confirmation
                Swal.fire({
                    title: 'Cancelling Order',
                    text: 'Your order cancellation status will be updated in 3 seconds.',
                    icon: 'success',
                    timer: 3000,
                    showConfirmButton: false,
                    willClose: () => {
                        // Send the reason to the backend
                        $.ajax({
                            url: `/cancelOrder`,
                            method: 'POST',
                            contentType: 'application/json',
                            data: JSON.stringify({ orderId: orderId, reason: reason }),
                            success: function(response) {
                                console.log(response);
                                window.location.href = '/orderStatus'; // Navigate to the orderStatus page
                            },
                            error: function(xhr, status, error) {
                                console.error("An error occurred while cancelling the order:", error);
                            }
                        });
                    }
                });
            }
        });
    }
</script>


        <script>
        function confirmReturn(orderId, displayOrderId) {
            Swal.fire({
                title: 'Are you sure?',
                text: `Do you want to return order ${displayOrderId}?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, return it!',
                input: 'textarea',  // Add a textarea input for the reason
                inputPlaceholder: 'Enter the reason for return...',
                inputValidator: (value) => {
                    if (!value) {
                        return 'You need to provide a reason for the return!';
                    }
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    const reason = result.value; // Get the reason from the input

                    // Display a message for confirmation
                    Swal.fire({
                        title: 'Returning Order',
                        text: 'Your order return status will be updated in 3 seconds.',
                        icon: 'success',
                        timer: 3000,
                        showConfirmButton: false,
                        willClose: () => {
                            // Send the reason to the backend
                            $.ajax({
                                url: `/returnOrder`,
                                method: 'POST',
                                contentType: 'application/json',
                                data: JSON.stringify({ orderId: orderId, reason: reason }),
                                success: function(response) {
                                    console.log(response);
                                    window.location.href = '/orderStatus'; // Navigate to the orderStatus page
                                },
                                error: function(xhr, status, error) {
                                    console.error("An error occurred while returning the order:", error);
                                }
                            });
                        }
                    });
                }
            });
        }
    </script>
        <script>
            $(document).ready(function () {
                $(".form").submit(function (e) {
                    e.preventDefault();
                    console.log("Form submitted");
                    var formData = $(this).serialize();
                    var totalAmountPay = document.getElementById("totalAmountPay").value
                    var orderId = document.getElementById("orderId").value

                    $.ajax({
                        url: "/repayOrder",
                        type: "POST",
                        data: formData,
                        success: function (res) {
                            console.log("Server response:", res);
                            if (res.success) {
                                var options = {
                                    "key": res.key_id,
                                    "amount": res.amount,
                                    "currency": "INR",
                                    "order_id": res.orderId,
                                    "handler": function (response) {
                                        Swal.fire({
                                            icon: 'success',
                                            title: 'Payment Successful',
                                            text: 'Your payment has been processed successfully.',
                                            confirmButtonText: 'OK'
                                        }).then((result) => {
                                            if (result.isConfirmed) {
                                                window.location.href = `/repay?paid=1&orderId=${orderId}`
                                            }
                                        });
                                        console.log("Payment response:", response);
                                    }
                                };
                                var razorpayObject = new Razorpay(options);
                                razorpayObject.on('payment.failed', function (response) {
                                    window.location.href = `/repay?paid=0&orderId=${orderId}`
                                    console.log("Payment failed response:", response);
                                });
                                razorpayObject.open();

                            } else {
                                alert(res.msg);
                            }
                        },
                        error: function (xhr, status, error) {
                            alert("An error occurred: " + error);
                            console.error("AJAX error:", error);
                        }
                    });
                });
            });
        </script>
</body>

</html>
