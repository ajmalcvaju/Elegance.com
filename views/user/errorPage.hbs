<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error 404 - Page Not Found</title>
<style>
    /* Dark Background */
    body {
        font-family: 'Poppins', sans-serif;
        background: #121212;
        color: #ffffff;
        text-align: center;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100vh;
    }

    /* 404 Text Styling */
    .error-heading {
        font-size: 6em;
        font-weight: 800;
        color: #ff4444;
        text-shadow: 0px 0px 10px rgba(255, 68, 68, 0.6);
        text-transform: uppercase;
    }

    /* Error Message */
    .error-message {
        font-size: 1.4em;
        margin-bottom: 20px;
        color: #bbbbbb;
    }

    /* Back to Home Button */
    .back-to-home-btn {
        background: linear-gradient(45deg, #ff4b2b, #ff416c);
        color: white;
        padding: 12px 25px;
        font-size: 1.2em;
        text-decoration: none;
        border-radius: 8px;
        transition: all 0.3s ease-in-out;
        border: 2px solid rgba(255, 255, 255, 0.2);
        display: inline-block;
    }

    .back-to-home-btn:hover {
        background: linear-gradient(45deg, #ff416c, #ff4b2b);
        transform: scale(1.05);
        box-shadow: 0 4px 10px rgba(255, 75, 75, 0.5);
    }

    /* Responsive Design */
    @media (max-width: 480px) {
        .error-heading {
            font-size: 4em;
        }
        .error-message {
            font-size: 1.2em;
        }
        .back-to-home-btn {
            font-size: 1em;
            padding: 10px 20px;
        }
    }
</style>
</head>
<body>
    <div class="error-container">
        <div class="error-heading">404</div>
        <div class="error-message">Oops! The page you are looking for does not exist.</div>
        <a href="/" class="back-to-home-btn">Back to Home</a>
    </div>
</body>
</html>
