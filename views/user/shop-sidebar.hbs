<!doctype html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="description" content="">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Elegance</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="/css/bootstrap.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" type="text/css" href="/css/all.min.css">
    <link rel="stylesheet" href="/css/uicons-regular-rounded.css">
    <link rel="stylesheet" type="text/css" href="/css/responsive.css">
    <link rel="stylesheet" href="styles.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://unpkg.com/swiper/swiper-bundle.min.css">
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <style>
        body {
            background-color: #121212;
        }

        #add-to-cart-link:hover {
            cursor: pointer;
        }

        #searchInput {
            background-color: rgb(214, 213, 213);
        }

        /* Hover Effects */
        .btn-dark:hover,
        .btn-outline-light:hover {
            background-color: #FFD700 !important;
            color: black !important;
            border-color: #FFD700 !important;
        }

        .btn-warning:hover {
            background-color: #FF5722 !important;
            border-color: #FF5722 !important;
        }

        /* Responsive Styles */
        @media (max-width: 768px) {
            .block-sidebar {
                text-align: center;
            }

            .block-lst {
                justify-content: center;
            }
        }

        .navbar-dark .nav-link {
            color: white;
            font-size: 1.1rem;
            font-weight: 600;
        }

        .navbar-dark .nav-link:hover {
            color: #a855f7;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .block-product {
                margin: 0 auto 20px auto;
            }
        }
    </style>
    <style>
        @media (max-width: 1024px) {

            .top-bar,
            .main-pd {
                display: none;
            }
        }
    </style>
</head>

<body>
    <header class="bg-gray-900">
        <nav class="bg-gray-800 shadow-md">
            <div class="container mx-auto px-4 py-3 flex justify-between items-center">
                <!-- Logo -->
                <a href="/" class="text-white text-3xl font-extrabold tracking-wider">
                    <span class="text-purple-400">Elegance</span>
                </a>

                <!-- Desktop Menu -->
                <ul class="hidden md:flex space-x-6 text-white font-semibold">
                    <li><a href="/" class="hover:text-blue-400 transition duration-300 text-lg">Home</a></li>
                    <li><a href="/shop" class="hover:text-purple-400 transition duration-300 text-lg">Shop</a></li>
                    <li><a href="/myProfile"
                            class="flex items-center hover:text-green-400 transition duration-300 text-lg">
                            <i class="fa-solid fa-user text-xl mr-2"></i> My Profile</a></li>
                    <li><a href="/myWishlist"
                            class="flex items-center hover:text-yellow-400 transition duration-300 text-lg">
                            <i class="fa-solid fa-heart text-xl mr-2"></i> My Wishlist</a></li>
                    <li><a href="/cart"
                            class="flex items-center hover:text-red-400 transition duration-300 text-lg font-semibold">
                            <i class="fa-solid fa-shopping-cart text-xl mr-2"></i> My Cart</a></li>
                    {{#if login}}
                    <li><a href="/uSignout" class="hover:text-red-500 transition duration-300 text-lg">
                            <i class="fa-solid fa-sign-out-alt text-xl mr-2"></i> Logout</a></li>
                    {{else}}
                    <li><a href="/login" class="hover:text-blue-500 transition duration-300 text-lg">
                            <i class="fa-solid fa-sign-in-alt text-xl mr-2"></i> Login</a></li>
                    {{/if}}
                </ul>

                <!-- Mobile Menu Button -->
                <button id="mobile-menu-button" class="block md:hidden text-white text-3xl focus:outline-none">
                    <i class="fa-solid fa-bars"></i>
                </button>
            </div>
        </nav>

        <!-- Mobile Menu -->
        <div id="mobile-menu"
            class="fixed inset-0 h-full w-64 bg-gray-800 shadow-lg transform -translate-x-full transition-transform duration-300 ease-in-out z-50">
            <div class="p-5">
                <!-- Logo and Close Button -->
                <div class="flex justify-between items-center">
                    <a href="/" class="text-white text-2xl font-extrabold tracking-wider">
                        <span class="text-purple-400">Elegance</span>
                    </a>
                    <button id="close-menu" class="text-white text-3xl focus:outline-none">
                        <i class="fa-solid fa-times"></i>
                    </button>
                </div>

                <!-- Mobile Navigation -->
                <ul class="text-gray-300 flex flex-col space-y-4 mt-4">
                    <li><a href="/" class="hover:text-blue-400 text-lg">Home</a></li>
                    <li><a href="/shop" class="hover:text-purple-400 text-lg">Shop</a></li>
                    <li><a href="/myProfile" class="flex items-center hover:text-green-400 text-lg">
                            <i class="fa-solid fa-user text-xl mr-2"></i> My Profile</a></li>
                    <li><a href="/myWishlist" class="flex items-center hover:text-yellow-400 text-lg">
                            <i class="fa-solid fa-heart text-xl mr-2"></i> My Wishlist</a></li>
                    <li><a href="/cart" class="flex items-center hover:text-red-400 text-lg font-semibold">
                            <i class="fa-solid fa-shopping-cart text-xl mr-2"></i> My Cart</a></li>
                    {{#if login}}
                    <li><a href="/uSignout" class="hover:text-red-500 text-lg">
                            <i class="fa-solid fa-sign-out-alt text-xl mr-2"></i> Logout</a></li>
                    {{else}}
                    <li><a href="/login" class="hover:text-blue-500 text-lg">
                            <i class="fa-solid fa-sign-in-alt text-xl mr-2"></i> Login</a></li>
                    {{/if}}
                </ul>
            </div>
        </div>
    </header>

    <!-- JavaScript for Mobile Menu -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const menuButton = document.getElementById("mobile-menu-button");
            const closeButton = document.getElementById("close-menu");
            const mobileMenu = document.getElementById("mobile-menu");

            menuButton.addEventListener("click", () => {
                mobileMenu.classList.remove("-translate-x-full");
            });

            closeButton.addEventListener("click", () => {
                mobileMenu.classList.add("-translate-x-full");
            });
        });
    </script>

    <section class="sp-wrap org v2" style="background-color: #121212;">
        <div class="w-100">
            <div class="container">
                <div class="row">
                    <!-- Sidebar Filters -->
                    <div class="col-lg-3 col-md-12 col-sm-12">
                        <div class="block-sidebar p-3" style="
        background: linear-gradient(145deg, #1E1E1E, #252525);
        border-radius: 15px;
        box-shadow: 5px 5px 15px rgba(0, 0, 0, 0.5), -5px -5px 15px rgba(255, 255, 255, 0.05);
    ">
                            <h3 class="text-white text-center mb-3" style="font-weight: bold; letter-spacing: 1px;">✨
                                Filters ✨</h3>

                            <!-- Categories -->
                            <h4 class="text-warning"><u>Categories</u></h4>
                            <div class="content">
                                {{#each categories}}
                                <div class="block-lst d-flex justify-content-between align-items-center mb-2">
                                    <a href="/advanceSearch?category={{this.cname}}&Psort={{priceSort}}&Asort={{alphabetSort}}"
                                        class="btn w-100 {{#if (eq this.cname ../category)}}border-warning text-warning{{/if}}"
                                        style="background: #333; color: white; padding: 8px; border-radius: 6px; font-size: 14px;">
                                        {{this.cname}}
                                    </a>
                                </div>
                                {{/each}}
                                <a href="/advanceSearch?category=&Psort={{priceSort}}&Asort={{alphabetSort}}"
                                    class="btn btn-danger w-100 py-1">❌ Clear Filter</a>
                            </div>

                            <!-- Price Sorting -->
                            <h4 class="text-warning mt-3"><u>Price</u></h4>
                            <div class="content">
                                <a href="/advanceSearch?category={{category}}&Psort=1&Asort={{alphabetSort}}"
                                    class="btn w-100 mb-1"
                                    style="background: #007bff; color: white; padding: 8px; border-radius: 6px; font-size: 14px;">
                                    🔼 Low to High
                                </a>
                                <a href="/advanceSearch?category={{category}}&Psort=-1&Asort={{alphabetSort}}"
                                    class="btn w-100 mb-1"
                                    style="background: #ff5722; color: white; padding: 8px; border-radius: 6px; font-size: 14px;">
                                    🔽 High to Low
                                </a>
                                <a href="/advanceSearch?category={{category}}&Psort=&Asort={{alphabetSort}}"
                                    class="btn btn-danger w-100 py-1">❌ Clear Filter</a>
                            </div>

                            <!-- Alphabet Sorting -->
                            <h4 class="text-warning mt-3"><u>Alphabet Sorting</u></h4>
                            <div class="content">
                                <a href="/advanceSearch?category={{category}}&Psort={{priceSort}}&Asort=1"
                                    class="btn w-100 mb-1"
                                    style="background: #28a745; color: white; padding: 8px; border-radius: 6px; font-size: 14px;">
                                    🔠 A-Z
                                </a>
                                <a href="/advanceSearch?category={{category}}&Psort={{priceSort}}&Asort=-1"
                                    class="btn w-100 mb-1"
                                    style="background: #dc3545; color: white; padding: 8px; border-radius: 6px; font-size: 14px;">
                                    🔠 Z-A
                                </a>
                                <a href="/advanceSearch?category={{category}}&Psort={{priceSort}}&Asort="
                                    class="btn btn-danger w-100 py-1">❌ Clear Filter</a>
                            </div>

                            <!-- Clear All Filters -->
                            <a href="/advanceSearch?category=&Psort=&Asort=" class="btn w-100 mt-3"
                                style="background: #ffc107; color: black; font-weight: bold; padding: 10px; border-radius: 6px; font-size: 14px;">
                                🚀 Clear All Filters
                            </a>
                        </div>
                    </div>



                    <!-- Products Section -->
                    <div class="col-lg-9 col-sm-12 col-md-12">
                        <div class="row">
                            {{#each products}}
                            {{#unless this.is_deleted}}
                            {{#if this.purchase}}
                            <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                                <div class="block-product p-3"
                                    style="background: #1E1E1E; border-radius: 12px; box-shadow: 0px 4px 10px rgba(255, 255, 255, 0.1);">
                                    <div class="product-thumb position-relative text-center">
                                        <a href="/product-details?id={{this._id}}">
                                            <img src="{{this.image.[0]}}" class="img-fluid rounded"
                                                style="height: 250px; object-fit: cover; border-radius: 8px;">
                                        </a>
                                        <span class="position-absolute"
                                            style="top: 10px; left: 10px; background: crimson; color: white; padding: 5px 10px; border-radius: 4px;">
                                            Save {{this.actualDiscount}}%
                                        </span>
                                        <span onclick="addToCart(event, '{{this._id}}')"
                                            class="ad-cart position-absolute text-center d-block mt-2 py-2" style="width: 100%; background: #FF5722; color: white; font-weight: bold; 
                                               border-radius: 4px; cursor: pointer; transition: 0.3s;">
                                            Add to Cart
                                        </span>
                                    </div>
                                    <div class="product-body text-center mt-3">
                                        <a href="#" class="brand-name"
                                            style="color: white; font-weight: bold; font-size: 1.2em;">{{this.pname}}</a>
                                        <h2 class="product-name" style="font-size: 1em; color: #FFD700;">
                                            <a href="#">{{this.brand}}</a>
                                        </h2>
                                        <span class="product-price"
                                            style="font-size: 1.3em; font-weight: bold;">₹{{this.discountedPrice}}</span>
                                        <del style="color: red; font-size: 1em;">₹{{this.price}}</del>
                                    </div>
                                </div>
                            </div>
                            {{/if}}
                            {{/unless}}
                            {{/each}}
                        </div>

                        <!-- Pagination Controls -->
                        <div class="pagination-controls text-center mt-4">
                            {{#if (gt currentPage 1)}}
                            <a href="?page={{subtract currentPage 1}}&category={{category}}"
                                class="btn btn-outline-light">Previous</a>
                            {{/if}}

                            {{#each (range 1 totalPages)}}
                            <a href="?page={{this}}&category={{category}}"
                                class="btn {{#if (eq this ../currentPage)}}btn-warning{{else}}btn-outline-light{{/if}}">
                                {{this}}
                            </a>
                            {{/each}}

                            {{#if (lt currentPage totalPages)}}
                            <a href="?page={{add currentPage 1}}&category={{category}}"
                                class="btn btn-outline-light">Next</a>
                            {{/if}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <div class="section-width my-5">
        <div class="container">
            <div class="w-100 border-top" style="border-top-color: #ebebeb !important;"></div>
        </div>
    </div>
    <footer style="background: #111; color: white; padding: 30px 0;">

        <div class="container">
            <div class="row align-items-center">
                <!-- Brand Info -->
                <div class="col-lg-4 col-md-6 text-center text-md-start">
                    <h2 style="color: #f8b400;">Elegance</h2>
                    <p style="font-size: 14px; line-height: 1.5;">Discover style and comfort at Elegance, your go-to
                        apparel store for trendy and timeless pieces.</p>
                    <p style="margin-bottom: 5px; font-size: 14px;"><strong>Call us 24/7:</strong> <a
                            href="tel:+918714156151" style="color: #f8b400;">+91 8714156151</a></p>
                </div>

                <!-- Links -->
                <div class="col-lg-3 col-md-6 text-center text-md-start">
                    <h4 style="font-size: 18px; color: #f8b400;">Quick Links</h4>
                    <ul class="list-unstyled" style="font-size: 14px; margin: 0; padding: 0;">
                        <li><a href="/" style="color: white; text-decoration: none;">Home</a></li>
                        <li><a href="/shop" style="color: white; text-decoration: none;">Shop</a></li>
                        <li><a href="/myProfile" style="color: white; text-decoration: none;">My Profile</a></li>
                        <li><a href="/cart" style="color: white; text-decoration: none;">My Cart</a></li>
                        <li><a href="/myWishlist" style="color: white; text-decoration: none;">My Wishlist</a></li>
                    </ul>
                </div>

                <!-- Social Media -->
                <div class="col-lg-5 col-md-12 text-center text-md-end">
                    <h4 style="font-size: 18px; color: #f8b400;">Follow Us</h4>
                    <div class="d-flex justify-content-center justify-content-md-end gap-2">
                        <a href="#" style="color: white; font-size: 18px;"><i class="fa-brands fa-facebook-f"></i></a>
                        <a href="#" style="color: white; font-size: 18px;"><i class="fa-brands fa-twitter"></i></a>
                        <a href="#" style="color: white; font-size: 18px;"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" style="color: white; font-size: 18px;"><i class="fa-brands fa-youtube"></i></a>
                    </div>
                </div>
            </div>

            <hr style="border-color: rgba(255, 255, 255, 0.2); margin: 15px 0;">

            <!-- Bottom Section -->
            <div class="row">
                <div class="col text-center">
                    <p style="margin: 0; font-size: 13px;">© 2024 Elegance Store. All Rights Reserved | <a href="#"
                            style="color: #f8b400;">Privacy Policy</a></p>
                </div>
            </div>
        </div>
    </footer>
    <script src="/js/bootstrap.bundle.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"></script>
    <script>

        $(document).ready(function () {
            $.get('/add-to-cart', function (data) {
                $('#reloadArea').html(data);
            });
        });
        function changeMainImage(imageSrc) {
            var mainImage = document.getElementById("mainImage");
            mainImage.src = "/productImages/" + imageSrc;
        }
        $(document).ready(function () {
            function filterProducts() {
                var value = $("#searchInput").val().toLowerCase();
                $(".row #product").each(function () {
                    var text = $(this).text().toLowerCase();
                    $(this).toggle(text.indexOf(value) > -1);
                });
            }

            $("#searchInput").on("keyup", function () {
                filterProducts();
            });

            $("#searchByIdButton").on("click", function () {
                filterProducts();
                $("#searchInput").val("");
            });
        });
        function addToCart(productId) {
            console.log(productId)
        }

    </script>
    <script>
        async function addToCart(event, productId) {
            event.preventDefault();
            // Make an asynchronous request to add the product to the cart
            fetch(`/add-to-cart?id=${productId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        if (data.isProductInCart) {
                            failMessage();
                        } else if (data.notLogin) {
                            loginMessage();
                        } else {
                            successMessage();

                        }
                    } else {
                        console.error('Error:', data.message);
                    }
                })
                .catch(error => {
                    console.error(error);
                    // Handle error if needed
                });
        }

        function successMessage() {
            Swal.fire({
                text: 'Product successfully added to cart',
                icon: 'success',
                confirmButtonText: 'OK',
                customClass: {
                    title: 'text-success',
                    popup: 'swal2-popup-custom',
                    confirmButton: 'btn btn-success'
                },
                showCancelButton: false,
                showCloseButton: true,
                showLoaderOnConfirm: false,
                timer: 3000
            });
        }

        function failMessage() {
            Swal.fire({
                text: 'Product Already Present in the cart ',
                icon: 'error',
                confirmButtonText: 'OK',
                customClass: {
                    title: 'text-danger',
                    popup: 'swal2-popup-custom',
                    confirmButton: 'btn btn-danger'
                },
                showCancelButton: false,
                showCloseButton: true,
                showLoaderOnConfirm: false,
                timer: 3000
            });
        }

        function loginMessage() {
            Swal.fire({
                text: 'You have not Logged in in Your Account ',
                icon: 'error',
                confirmButtonText: 'OK',
                customClass: {
                    title: 'text-danger',
                    popup: 'swal2-popup-custom',
                    confirmButton: 'btn btn-danger'
                },
                showCancelButton: false,
                showCloseButton: true,
                showLoaderOnConfirm: false,
                timer: 3000
            });
        }
    </script>

</body>

</html>