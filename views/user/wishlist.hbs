<!DOCTYPE html>
<html lang="en">

<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>My Wishlist</title>
	<link href="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
	<link rel="stylesheet" href="/myWishlist.css">
	<script src="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>
	<script src="//cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
	 <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* General Styles */
        body {
            background: linear-gradient(to right, #141e30, #243b55);
            color: white;
            font-family: 'Poppins', sans-serif;
        }

        .cart-wrap {
            padding: 40px 0;
        }

        .breadcrumb {
            background: transparent;
            justify-content: center;
        }

        .breadcrumb-item a {
            color: #ffcc00;
            text-decoration: none;
            font-weight: bold;
        }

        .breadcrumb-item.active {
            color: #ffffff;
            font-weight: bold;
        }

        .main-heading {
            font-size: 36px;
            font-weight: bold;
            color: #ffcc00;
            text-align: center;
            margin-bottom: 20px;
        }

        .table-wishlist {
            background: rgba(255, 255, 255, 0.1);
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0px 0px 15px rgba(255, 255, 255, 0.2);
        }

        table {
            width: 100%;
        }

        th {
            color: #ffcc00;
            font-size: 18px;
            padding: 15px;
            text-align: center;
        }

        td {
            padding: 15px;
            vertical-align: middle;
            text-align: center;
        }

        /* Buttons */
        .round-black-btn {
            background: #ffcc00;
            color: #000;
            padding: 10px 18px;
            border-radius: 20px;
            font-weight: bold;
            text-decoration: none;
            transition: 0.3s;
            display: inline-block;
        }

        .round-black-btn:hover {
            background: #ffc107;
            color: black;
        }

        /* Delete Button */
        .delete-btn {
            background: #dc3545;
            color: white;
            padding: 8px 14px;
            border-radius: 50px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            text-decoration: none;
            transition: 0.3s;
            border: none;
            cursor: pointer;
        }

        .delete-btn:hover {
            background: #ff4444;
            transform: scale(1.1);
        }

        .delete-btn i {
            margin-right: 5px;
        }

        /* Product Image */
        .img-product img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 10px;
            border: 2px solid #ffcc00;
        }

        /* Stock Status */
        .in-stock-box {
            color: #4caf50;
            font-weight: bold;
            padding: 5px 10px;
            border-radius: 5px;
            background: rgba(76, 175, 80, 0.2);
        }

        /* Responsive Design */
        @media (max-width: 768px) {
            th, td {
                font-size: 14px;
                padding: 10px;
            }

            .img-product img {
                width: 60px;
                height: 60px;
            }

            .round-black-btn, .delete-btn {
                padding: 6px 12px;
                font-size: 14px;
            }
        }
    </style>
</head>

<body>
    <div class="cart-wrap">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-10">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/">Home</a></li>
                            <li class="breadcrumb-item"><a href="/shop">Shop</a></li>
                            <li class="breadcrumb-item active" aria-current="page">My Wishlist</li>
                        </ol>
                    </nav>

                    <div class="main-heading">My Wishlist</div>

                    <div class="table-wishlist mt-4">
                        {{#if noProduct}}
                        <h3 class="text-center text-warning">No Product in Wishlist</h3>
                        {{else}}
                        <table cellpadding="0" cellspacing="0" border="0">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Unit Price</th>
                                    <th>Stock</th>
                                    <th>Add to Cart</th>
                                    <th>Remove</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{#each wishlist}}
                                {{#each this.items}}
                                {{#if this.productId.purchase}}
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center justify-content-center">
                                            <div class="img-product">
                                                <img src="{{this.productId.image.[0]}}" alt="Product">
                                            </div>
                                            <div class="ms-3 fw-bold">
                                                {{this.productId.pname}}
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-warning fw-bold">${{this.productId.price}}</td>
                                    <td><span class="in-stock-box">In Stock</span></td>
                                    <td>
                                        <a class="round-black-btn" href="/add-cart?id={{this.productId._id}}">
                                            Add to Cart
                                        </a>
                                    </td>
                                    <td>
                                        <a href="/deleteWishlist?id={{this.productId._id}}" class="delete-btn">
                                            <i class="fas fa-trash-alt"></i> Delete
                                        </a>
                                    </td>
                                </tr>
                                {{/if}}
                                {{/each}}
                                {{/each}}
                            </tbody>
                        </table>
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>

</html>